{
	"name": "budpy",
	"version": "1.0.0",
	"description": "Budpy is an autonomous ESP32 CYD dashboard.",
	"private": true,
	"packageManager": "pnpm@10.33.2",
	"repository": {
		"url": "https://github.com/pyxel-dev/budpy"
	},
	"author": {
		"name": "Kevin Py",
		"url": "https://kevinpy.com"
	},
	"scripts": {
