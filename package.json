{
	"name": "budpy",
	"version": "1.2.0",
	"description": "Budpy is an autonomous ESP32 CYD dashboard.",
	"private": true,
	"packageManager": "pnpm@11.5.2",
	"repository": {
		"url": "https://github.com/pyxel-dev/budpy"
	},
	"author": {
		"name": "Kevin Py",
		"url": "https://kevinpy.com"
	},
	"scripts": {
		"build": "pnpm -r build",
		"test": "pnpm -r test",
		"typecheck": "pnpm -r typecheck",
		"generate:plugins": "node scripts/generate-plugin-registry.mjs",
		"firmware:publish": "node scripts/firmware-publish.mjs",
		"firmware:build": "node scripts/firmware-publish.mjs --build",
		"v:bump": "node scripts/version-bump.mjs"
	},
	"devDependencies": {
		"typescript": "^5.8.3"
	},
	"engines": {
		"node": ">=25",
		"pnpm": "11.5.2",
		"npm": "please-use-pnpm"
	}
}
